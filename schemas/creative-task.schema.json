{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chuhanma2-coder/mint-report-creativePPT/schemas/creative-task.schema.json",
  "title": "Mint Creative PPT collaboration task card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportTitle", "audience", "purpose", "template", "chapters", "commonRequirements"],
  "properties": {
    "schemaVersion": { "const": "creative-task-1.0" },
    "reportTitle": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": { "const": "mint-template-16x9/1" },
        "file": { "const": "Mint_PPT_16比9-template.pptx" }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "title", "owner", "objective", "sourcePaths"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "sourcePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "commonRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["businessFactsInBody", "appendixAllowed", "automaticPageNumbers", "bottomNotes"],
      "properties": {
        "businessFactsInBody": { "const": true },
        "appendixAllowed": { "const": false },
        "automaticPageNumbers": { "const": true },
        "bottomNotes": { "const": "only-if-business-critical-or-explicit" }
      }
    }
  }
}
